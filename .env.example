# Client-visible Supabase configuration. Copy this file to .env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-public-anon-key

# Optional local tooling values. Export these explicitly before invoking a
# device/signing script; the shared loader intentionally imports only the two
# Supabase client values above.
# ANDROID_DEVICE_ID=replace-with-your-local-device-id
# IOS_DEVICE_ID=replace-with-your-local-device-id
# IOS_TEAM_ID=replace-with-your-apple-developer-team-id
# APPLE_ID=replace-with-your-apple-id-email

# Never add SUPABASE_SERVICE_ROLE_KEY, an FCM service-account JSON/private key,
# signing credentials, or other server-side secrets to a client environment.
